{
  "name": "talabatk-backend",
  "version": "1.0.0",
  "description": "Backend API for Talabatk MakaneK delivery platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seed.js",
    "seed:sample": "node scripts/sample-seed.js",
    "test": "jest --runInBand"
